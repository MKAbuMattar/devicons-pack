{
  "name": "@devicons-pack/react",
  "version": "2.0.0-beta.0",
  "description": "Devicons as tree-shakeable typed React components (flat, high-contrast, modern). Successor of the react-dev-icon package.",
  "keywords": [
    "devicons",
    "icon",
    "dev-icon",
    "icons",
    "svg",
    "react"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MKAbuMattar/devicons-pack.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/devicons-pack/issues"
  },
  "homepage": "https://devicons-pack.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/core.cjs",
  "module": "./dist/core.js",
  "types": "./dist/core.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./original": {
      "import": {
        "types": "./dist/original/index.d.ts",
        "default": "./dist/original/index.js"
      },
      "require": {
        "types": "./dist/original/index.d.cts",
        "default": "./dist/original/index.cjs"
      }
    },
    "./original/*": {
      "import": {
        "types": "./dist/original/icons/*.d.ts",
        "default": "./dist/original/icons/*.js"
      },
      "require": {
        "types": "./dist/original/icons/*.d.cts",
        "default": "./dist/original/icons/*.cjs"
      }
    },
    "./plain": {
      "import": {
        "types": "./dist/plain/index.d.ts",
        "default": "./dist/plain/index.js"
      },
      "require": {
        "types": "./dist/plain/index.d.cts",
        "default": "./dist/plain/index.cjs"
      }
    },
    "./plain/*": {
      "import": {
        "types": "./dist/plain/icons/*.d.ts",
        "default": "./dist/plain/icons/*.js"
      },
      "require": {
        "types": "./dist/plain/icons/*.d.cts",
        "default": "./dist/plain/icons/*.cjs"
      }
    },
    "./line": {
      "import": {
        "types": "./dist/line/index.d.ts",
        "default": "./dist/line/index.js"
      },
      "require": {
        "types": "./dist/line/index.d.cts",
        "default": "./dist/line/index.cjs"
      }
    },
    "./line/*": {
      "import": {
        "types": "./dist/line/icons/*.d.ts",
        "default": "./dist/line/icons/*.js"
      },
      "require": {
        "types": "./dist/line/icons/*.d.cts",
        "default": "./dist/line/icons/*.cjs"
      }
    },
    "./original-wordmark": {
      "import": {
        "types": "./dist/original-wordmark/index.d.ts",
        "default": "./dist/original-wordmark/index.js"
      },
      "require": {
        "types": "./dist/original-wordmark/index.d.cts",
        "default": "./dist/original-wordmark/index.cjs"
      }
    },
    "./original-wordmark/*": {
      "import": {
        "types": "./dist/original-wordmark/icons/*.d.ts",
        "default": "./dist/original-wordmark/icons/*.js"
      },
      "require": {
        "types": "./dist/original-wordmark/icons/*.d.cts",
        "default": "./dist/original-wordmark/icons/*.cjs"
      }
    },
    "./plain-wordmark": {
      "import": {
        "types": "./dist/plain-wordmark/index.d.ts",
        "default": "./dist/plain-wordmark/index.js"
      },
      "require": {
        "types": "./dist/plain-wordmark/index.d.cts",
        "default": "./dist/plain-wordmark/index.cjs"
      }
    },
    "./plain-wordmark/*": {
      "import": {
        "types": "./dist/plain-wordmark/icons/*.d.ts",
        "default": "./dist/plain-wordmark/icons/*.js"
      },
      "require": {
        "types": "./dist/plain-wordmark/icons/*.d.cts",
        "default": "./dist/plain-wordmark/icons/*.cjs"
      }
    },
    "./line-wordmark": {
      "import": {
        "types": "./dist/line-wordmark/index.d.ts",
        "default": "./dist/line-wordmark/index.js"
      },
      "require": {
        "types": "./dist/line-wordmark/index.d.cts",
        "default": "./dist/line-wordmark/index.cjs"
      }
    },
    "./line-wordmark/*": {
      "import": {
        "types": "./dist/line-wordmark/icons/*.d.ts",
        "default": "./dist/line-wordmark/icons/*.js"
      },
      "require": {
        "types": "./dist/line-wordmark/icons/*.d.cts",
        "default": "./dist/line-wordmark/icons/*.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/core.tsx --format esm,cjs --dts --out-dir dist --clean && tsx build.ts",
    "test": "tsx test/smoke.tsx"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/react": "^19.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.3"
  }
}
