{
  "name": "@devicons-pack/sprite",
  "version": "2.1.0",
  "description": "Devicons as SVG symbol sprites — one <use href> sheet per set, ideal for pages showing many icons.",
  "keywords": [
    "fluentui",
    "icon",
    "fluentui-icon",
    "icons",
    "svg",
    "sprite",
    "symbol"
  ],
  "license": "MIT",
  "author": {
    "name": "Mohammad Abu Mattar",
    "email": "mohammad.khaled@outlook.com",
    "url": "https://mkabumattar.github.io/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MKAbuMattar/devicons-pack.git",
    "directory": "packages/sprite"
  },
  "bugs": {
    "url": "https://github.com/MKAbuMattar/devicons-pack/issues"
  },
  "homepage": "https://devicons-pack.mkabumattar.com/",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json",
    "./original.svg": "./dist/original.svg",
    "./plain.svg": "./dist/plain.svg",
    "./line.svg": "./dist/line.svg",
    "./original-wordmark.svg": "./dist/original-wordmark.svg",
    "./plain-wordmark.svg": "./dist/plain-wordmark.svg",
    "./line-wordmark.svg": "./dist/line-wordmark.svg"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --out-dir dist && tsx build.ts",
    "test": "tsx test/smoke.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
